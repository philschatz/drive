    "@schedule-x/calendar": "^4.1.0",
    "@schedule-x/current-time": "^4.1.0",
    "@schedule-x/events-service": "^4.1.0",
    "@schedule-x/theme-default": "^4.1.0",
    "@tailwindcss/vite": "^4.2.0",
    "buffer": "^6.0.3",
    "cbor-x": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "hyperformula": "^3.2.0",
    "ical.js": "^2.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.21.0",
