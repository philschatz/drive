{
  "name": "automerge-docs",
  "version": "1.0.0",
  "description": "Applications using Automerge",
  "main": "index.js",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/backend/serve.ts",
    "start:relay": "ts-node --transpile-only -r tsconfig-paths/register src/backend/relay-server.ts",
    "dev": "vite dev --port 3000",
    "build": "vite build && npm run slides",
    "serve:prod": "NODE_ENV=production PORT=4000 ts-node -r tsconfig-paths/register src/backend/serve.ts",
    "start:caldav": "ts-node -r tsconfig-paths/register src/backend/caldav-server.ts",
    "cli": "ts-node -r tsconfig-paths/register src/backend/cli.ts",
    "dev:caldav": "nodemon --watch src/backend --ext ts --exec ts-node -r tsconfig-paths/register src/backend/caldav-server.ts",
    "serve:caldav": "NODE_ENV=production CALDAV_PORT=4001 ts-node -r tsconfig-paths/register src/backend/caldav-server.ts",
    "test": "jest && npm run test:pw",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:merge": "mkdir -p coverage/combined && nyc merge coverage coverage/combined/coverage-final.json && nyc report --temp-dir coverage/combined --report-dir coverage/combined --reporter text-summary --reporter lcov",
    "coverage": "npm run test:coverage && npm run coverage:merge",
    "test:pw": "playwright test",
    "test:pw:open": "playwright test --ui",
    "stop": "pkill -f 'ts-node.*serve' || true",
    "syncthing": "node syncthing-automerge/merge.js ./.data",
    "slides": "mkdir -p dist/slides && marp --no-stdin docs/presentation.md -o dist/slides/presentation.html && marp --no-stdin docs/presentation-brief.md -o dist/slides/presentation-brief.html && marp --no-stdin docs/presentation-deep-dive.md -o dist/slides/presentation-deep-dive.html"
  },
  "engines": {
    "node": ">=22.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.1",
    "@automerge/automerge-repo": "^2.6.0-subduction.37",
    "@automerge/automerge-repo-keyhive": "0.3.0-alpha.sub.7",
    "@automerge/automerge-repo-network-messagechannel": "^2.6.0-subduction.37",
    "@automerge/automerge-repo-network-websocket": "^2.6.0-subduction.37",
    "@automerge/automerge-repo-storage-indexeddb": "^2.6.0-subduction.37",
    "@automerge/automerge-repo-storage-nodefs": "^2.6.0-subduction.37",
    "@automerge/automerge-subduction": "^0.16.0",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@keyhive/keyhive": "https://github.com/philschatz/keyhive/releases/download/drive-83a62cf/keyhive-drive-83a62cf.tgz",
    "@preact/signals": "^2.8.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
