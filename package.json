    "@testing-library/preact": "^3.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.1",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.11",
    "nyc": "^18.0.0",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "overrides": {
    "@automerge/automerge-repo-keyhive": {
      "@keyhive/keyhive": "https://github.com/philschatz/keyhive/releases/download/drive-83a62cf/keyhive-drive-83a62cf.tgz"
